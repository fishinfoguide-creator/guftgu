# Ye naam ka file copy kar ke ".env.local" bana lein aur apni Firebase
# console se values yahan paste karein. .env.local kabhi GitHub par push
# na karein (ye .gitignore mein pehle se excluded hai).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
