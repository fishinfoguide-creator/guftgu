rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App ka poora data ek hi "kv" collection mein rehta hai.
    // NOTE: Ye rules open hain (koi login/auth check nahi) taake demo jaldi
    // chal sake. Isay production mein aur secure karna chahiye (neeche
    // README mein "Security" section dekhein).
    match /kv/{docId} {
      allow read, write: if true;
    }
  }
}
